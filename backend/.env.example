# Memento - Environment Variables
# Copy this file to .env and adjust the values.

# Database
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# JWT Configuration
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=change-me-to-a-very-long-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Encryption key for Fernet (must be 32 bytes, base64-url-safe-encoded, 44 chars)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-valid-fernet-key-44-characters==

# Default Admin User
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-to-a-secure-admin-password
DEFAULT_ADMIN_EMAIL=admin@memento.app