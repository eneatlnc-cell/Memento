# ╔══════════════════════════════════════════════════════════════╗
# ║                  Memento - Environment                         ║
# ║              Copy this file to .env and edit values           ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Database ───────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# ── JWT Authentication ─────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# ── Encryption ─────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-fernet-key

# ── Default Admin Account ──────────────────────────────────────────
# These credentials are used to create the initial admin user on first startup.
# Change the password immediately after first login.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@example.com

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Agnes AI API ───────────────────────────────────────────────────
# API provider for AI chat, image generation, and video generation.
# Sign up at https://agnes-ai.com to get your API key.
AGNES_API_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_API_KEY=your-agnes-api-key-here